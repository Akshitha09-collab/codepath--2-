# Copy this file to .env and fill in real values before running the server.

# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
# Local:   mongodb://127.0.0.1:27017/codepath
# Atlas:   mongodb+srv://<user>:<password>@cluster0.mongodb.net/codepath
MONGO_URI=mongodb://127.0.0.1:27017/codepath

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Python ML service base URL
ML_SERVICE_URL=http://localhost:8000

# CORS - frontend origin
CLIENT_ORIGIN=http://localhost:5173
